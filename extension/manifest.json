{
  "manifest_version": 3,
  "name": "YouTube Presence Bridge",
  "version": "1.0.0",
  "description": "Sends what is playing on YouTube and YouTube Music to the local youtube-presence script.",
  "incognito": "spanning",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
